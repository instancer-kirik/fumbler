growth[2]: deepening_craft,emotional_resilience
values[3]: autonomy,authenticity,emergence_over_control

# ============================================================================
# EXPERIENTIAL
# ============================================================================

loops[4]:
  withdraw-seek-withdraw when triggered
  intellectualize before feeling
  need full resolution before moving on
  escalate quickly then recover slowly

lessons[4]:
  caretaking is control; stop saving people
  my intensity scares people away; I need to slow down
  I can't demand reciprocity; I can only choose alignment
  vulnerability is a strength, not a burden

