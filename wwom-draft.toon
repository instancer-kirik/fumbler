# ============================================================================
# CORE RESONANCE
# ============================================================================

attention:
  type: resonance_not_persuasion
  desc: Engagement occurs through emergent alignment, not direct convincing.

vectors[3]{type,items[]}:
  activation,competent_weirdness|layered_meaning|curiosity_invitation
  repulsion,performative_confidence|over_explanation|extractive_attention

flirt[2]{category,items[]}:
  attracts,calm_curiosity|subtle_mastery|specific_noticing
  fails_when,intensity_too_early|emotional_oversharing_without_context|mirroring_too_aggressively

trust[2]{type,items[]}:
  trust_signals,artifact_built_tools|intentional_rough_edges|depth_discoverable_over_time
  distrust_signals,over_polished_emptiness|hidden_complexity

glossary[2]{term,meaning,state}:
  leethia,misunderstanding resolving into clarity,emergent_insight
  pattern_emergence,when disparate signals suddenly cohere into shape,recognition

# ============================================================================
# VIABILITY
# ============================================================================

availability:
